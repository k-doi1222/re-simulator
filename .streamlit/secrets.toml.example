# 接続情報の雛形。実際の値は書かないこと。
#
# 【手元のパソコンで動かす場合】
#   このファイルを同じフォルダに secrets.toml という名前でコピーし、値を書き換える。
#   secrets.toml は .gitignore 済みなのでGitには載らない。
#
# 【Streamlit Community Cloud で動かす場合】
#   アプリの設定画面（Settings → Secrets）に、下と同じ形式で貼り付ける。
#   暗号化して保管され、実行時だけ読み込まれる。

[app]
# アプリを開くときのパスワード。自分で決めた文字列を入れる。
password = "ここに好きなパスワードを書く"

[db]
# Supabase ダッシュボード → 右上の [Connect] → [Direct] タブ
#   → Session pooler の Connection string をコピーする。
#
# 貼ったあと2箇所を直すこと：
#   1) 先頭を postgresql:// から postgresql+psycopg:// にする
#   2) [YOUR-PASSWORD] をデータベースのパスワードに置き換える（角括弧ごと消す）
#
# ★ Direct connection（ホスト名が db.〜.supabase.co のもの）は IPv6 専用のため、
#    IPv6非対応の回線からは接続できない。必ず Session pooler を使うこと。
url = "postgresql+psycopg://postgres.<プロジェクトID>:<パスワード>@<ホスト>:5432/postgres"
